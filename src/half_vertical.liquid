{% assign alignment = trmnl.plugin_settings.custom_fields_values.text_alignment | default: 'Center' %}
{% if alignment == 'Left' %}
  {% assign richtext_align = '' %}
  {% assign content_align = 'text--left' %}
{% elsif alignment == 'Right' %}
  {% assign richtext_align = 'richtext--right' %}
  {% assign content_align = '--right text--right' %}
{% else %}
  {% assign richtext_align = 'richtext--center' %}
  {% assign content_align = '--center text--center' %}
{% endif %}
{% assign default_quote = 'The only way to do great work is to love what you do.' %}
{% assign default_author = 'Steve Jobs' %}
{% assign quote_text = quote | default: data.quote | default: default_quote %}
{% assign quote_author = author | default: data.author | default: default_author %}
<div class="layout">
  <div class="columns">
    <div class="column">
      <div class="markdown gap--large">
        <div class="richtext {{ richtext_align }} gap--xxlarge">
          <div class="content content--large {{ content_align }} gap--medium">
            <span class="value value--large" data-value-fit="true" data-value-fit-max-height="170">
              <span>{{ quote_text }}</span>
            </span>
            {% if quote_author and quote_author != '' %}
              <div class="value value--small text--gray-2">
                <span>{{ quote_author }}</span>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% unless trmnl.plugin_settings.custom_fields_values.hide_title_bar == 'Yes' %}
  <div class="title_bar">
    <img
      class="image"
      src="https://raw.githubusercontent.com/nicholaswilde/trmnl-google-sheet-quote/refs/heads/main/src/img/sheet-quote.svg"
      width="40"
      height="40"
    >
    <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
    <span class="instance">Display a daily quote from a Google Sheet</span>
  </div>
{% endunless %}
